@startuml
title Архитектура тестового фреймворка TeamCity

top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam shadowing false
skinparam defaultFontSize 16
skinparam ArrowFontSize 12
skinparam ArrowColor #65717D
skinparam ComponentBorderColor #65717D
skinparam ComponentBackgroundColor #FFFFFF
skinparam PackageBorderColor #65717D
skinparam nodesep 70
skinparam ranksep 90

legend top left
  |= Line |= Meaning |
  | solid | runtime call or interaction |
  | dashed | code, model or settings dependency |
endlegend

' =========================================================
' TEST LAYER
' =========================================================

package "Tests" <<Layer>> as TestArea #F4F4F4 {
  component "Pytest suites\nAPI · UI" as TestSuites
  component "Fixtures & context\nsetup · sessions · teardown" as Fixtures

  TestSuites --> Fixtures : fixtures
}

' =========================================================
' UI + IDENTITY / PROJECT
' =========================================================

package "UI + Identity / Project" as UiArea #EAF4FF {
  component "Page Objects\nBasePage + feature pages" as PageObjects
  component "UI components & routes\nTeamCityHeader · TeamCityRoutes" as UiNavigation
  component "UI authentication & state\nUiAuthClient · SessionStorage" as UiIntegration
  component "Identity & Project DTOs\nusers · tokens · roles · projects" as IdentityProjectDtos

  PageObjects --> UiNavigation : navigation
  PageObjects ..> IdentityProjectDtos : models
  UiIntegration ..> IdentityProjectDtos : credentials
}

' =========================================================
' API + BUILD
' =========================================================

package "API + Build" as ApiArea #ECF8EA {
  component "API composition\nApiManager · domain steps" as ApiComposition
  component "HTTP request pipeline\nrequesters · endpoints · specs" as HttpPipeline
  component "TeamCity configuration adapter\nConfigurationSteps · configuration client" as ConfigurationAdapter
  component "Build DTOs\nconfigurations · steps · executions" as BuildDtos

  ApiComposition --> HttpPipeline : requests
  ApiComposition --> ConfigurationAdapter : persistence
  ApiComposition ..> BuildDtos : models
  ConfigurationAdapter ..> BuildDtos : expected model
}

' =========================================================
' FRAMEWORK SERVICES
' =========================================================

package "Framework Services" as SupportArea #FFF5D9 {
  component "Test data generation\nrandom models · build scenarios" as TestData
  component "Model verification\nassertions · comparator · rules" as Verification
  component "Test lifecycle\nregistry · cleanup" as Lifecycle
  component "Database verification\nDatabaseSteps · DAO · DBRequest" as DatabaseVerification
  component "HSQLDB backup client\nBackup API · snapshot executor" as HsqlDbAdapter
  component "PostgreSQL client\nread-only connection · SQL executor" as PostgreSqlAdapter
  component "Cross-cutting support\nconfig · timeouts · constants · Allure" as CrossCutting

  TestData ..> CrossCutting : constants
  DatabaseVerification --> HsqlDbAdapter : backup mode
  DatabaseVerification --> PostgreSqlAdapter : PostgreSQL mode
  HsqlDbAdapter ..> CrossCutting : settings & timeouts
  PostgreSqlAdapter ..> CrossCutting : connection settings
}

' =========================================================
' TEAMCITY ENVIRONMENT
' =========================================================

package "TeamCity Environment" <<External>> as RuntimeArea #F4F4F4 {
  component "TeamCity UI" as TeamCityUi
  component "TeamCity REST API" as TeamCityRest
  component "TeamCity configuration files\nData Directory · XML" as TeamCityConfiguration
  component "TeamCity Backup API" as TeamCityBackupApi
  artifact "HSQLDB backup snapshot\nZIP · database_dump" as HsqlDbSnapshot
  database "PostgreSQL" as PostgreSql
}

' =========================================================
' PROJECT-WIDE FLOW
' =========================================================

TestSuites --> PageObjects : UI scenarios
TestSuites --> ApiComposition : API scenarios
Fixtures --> UiIntegration : authenticated context
Fixtures --> TestData : generated data
Fixtures --> Lifecycle : teardown

PageObjects --> TeamCityUi : Playwright
UiIntegration --> TeamCityRest : REST auth
HttpPipeline --> TeamCityRest : HTTP
ConfigurationAdapter --> TeamCityConfiguration : XML via Docker
HsqlDbAdapter --> TeamCityBackupApi : backup REST
TeamCityBackupApi --> HsqlDbSnapshot : creates ZIP
HsqlDbAdapter --> HsqlDbSnapshot : reads snapshot
PostgreSqlAdapter --> PostgreSql : read-only SQL

TestData ..> IdentityProjectDtos : generates
TestData ..> BuildDtos : generates
ApiComposition ..> IdentityProjectDtos : models
ApiComposition ..> Verification : assertions
ApiComposition ..> Lifecycle : registration
ApiComposition --> DatabaseVerification : DB checks

' Layout anchors: tests -> feature areas -> support -> runtime.
TestArea -[hidden]down- UiArea
UiArea -[hidden]right- ApiArea
UiArea -[hidden]down- SupportArea
ApiArea -[hidden]down- SupportArea
SupportArea -[hidden]down- RuntimeArea

@enduml
