@startuml
title Архитектура тестового фреймворка TeamCity

top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam shadowing false
skinparam defaultFontSize 16
skinparam ArrowFontSize 12
skinparam ArrowColor #65717D
skinparam ComponentBorderColor #65717D
skinparam ComponentBackgroundColor #FFFFFF
skinparam PackageBorderColor #65717D
skinparam nodesep 70
skinparam ranksep 90

legend top left
  |= Line |= Meaning |
  | solid | runtime call or interaction |
  | dashed | code, model or settings dependency |
endlegend

' =========================================================
' TESTS
' =========================================================

package "Tests" <<Layer>> as TestArea #F4F4F4 {
  component "Pytest suites\nAPI · UI" as TestSuites
}

' =========================================================
' TEST ORCHESTRATION
' =========================================================

package "Test Orchestration" <<Layer>> as OrchestrationArea #EAF4FF {
  component "Fixtures & test context\nsetup · SessionStorage · teardown" as Fixtures
  component "UI orchestration\nPage Objects · components · routes" as UiOrchestration
  component "API orchestration\nApiManager · domain steps" as ApiOrchestration
  component "Persistence verification\nConfigurationSteps · DatabaseSteps" as PersistenceSteps

  ApiOrchestration --> PersistenceSteps : coordinates checks
}

' =========================================================
' FRAMEWORK ADAPTERS
' =========================================================

package "Framework Adapters" <<Layer>> as AdaptersArea #ECF8EA {
  component "UI authentication adapter\nUiAuthClient" as UiAuthAdapter
  component "REST adapter\nrequesters · endpoints · specs" as RestAdapter
  component "Configuration adapter\nTeamCityConfigurationClient" as ConfigurationAdapter
  component "Database access facade\nclient factory · DAO · DBRequest" as DatabaseAccess
  component "HSQLDB backup adapter\nclient · snapshot executor" as HsqlDbAdapter
  component "PostgreSQL adapter\nclient · SQL executor" as PostgreSqlAdapter

  PersistenceSteps --> ConfigurationAdapter : configuration checks
  PersistenceSteps --> DatabaseAccess : database checks
  DatabaseAccess --> HsqlDbAdapter : backup mode
  DatabaseAccess --> PostgreSqlAdapter : PostgreSQL mode
}

' =========================================================
' DATA CONTRACTS
' =========================================================

package "Data Contracts" <<Layer>> as DataContractsArea #F1EFF8 {
  component "Identity & Project DTOs\nusers · tokens · roles · projects" as IdentityProjectDtos
  component "Build DTOs\nconfigurations · steps · executions" as BuildDtos
}

' =========================================================
' FRAMEWORK SERVICES
' =========================================================

package "Framework Services" <<Layer>> as ServicesArea #FFF5D9 {
  component "Test data generation\nrandom models · build scenarios" as TestData
  component "Model verification\nassertions · comparator · rules" as Verification
  component "Test lifecycle\nregistry · cleanup" as Lifecycle
  component "Framework configuration\nconfig · timeouts · constants" as FrameworkConfiguration
  component "Allure metadata\ntags · suite · feature · story" as AllureMetadata

  TestData ..> FrameworkConfiguration : constants
}

' =========================================================
' TEAMCITY ENVIRONMENT
' =========================================================

package "TeamCity Environment" <<External>> as EnvironmentArea #F4F4F4 {
  package "TeamCity Server" as TeamCityServer #FFFFFF {
    component "TeamCity UI" as TeamCityUi
    component "TeamCity REST API" as TeamCityRest
    component "TeamCity Backup API" as TeamCityBackupApi
    component "Configuration files\nData Directory · XML" as TeamCityConfiguration
    artifact "HSQLDB backup snapshot\nZIP · database_dump" as HsqlDbSnapshot
  }

  component "TeamCity Agent" as TeamCityAgent
  database "PostgreSQL" as PostgreSql

  TeamCityServer --> TeamCityAgent : dispatches builds
  TeamCityServer --> PostgreSql : persists data
}

' =========================================================
' PROJECT-WIDE FLOW
' =========================================================

TestSuites --> Fixtures : fixtures
TestSuites --> UiOrchestration : UI scenarios
TestSuites --> ApiOrchestration : API scenarios & setup
TestSuites ..> AllureMetadata : reporting metadata

Fixtures --> UiAuthAdapter : authenticated context
Fixtures --> TestData : generated data
Fixtures --> Lifecycle : teardown

UiOrchestration --> TeamCityUi : Playwright
ApiOrchestration --> RestAdapter : requests
ApiOrchestration --> Verification : assertions
ApiOrchestration --> Lifecycle : registration

UiAuthAdapter --> TeamCityRest : REST auth
RestAdapter --> TeamCityRest : HTTP
ConfigurationAdapter --> TeamCityConfiguration : XML via Docker
HsqlDbAdapter --> TeamCityBackupApi : backup REST
TeamCityBackupApi --> HsqlDbSnapshot : creates ZIP
HsqlDbAdapter --> HsqlDbSnapshot : reads snapshot
PostgreSqlAdapter --> PostgreSql : read-only SQL

OrchestrationArea ..> DataContractsArea : uses DTOs
TestData ..> DataContractsArea : generates DTOs
Verification ..> DataContractsArea : compares models
AdaptersArea ..> FrameworkConfiguration : settings & timeouts

' Stable overview layout: main flow in the center, shared layers on the sides.
TestArea -[hidden]down- OrchestrationArea
ServicesArea -[hidden]right- OrchestrationArea
OrchestrationArea -[hidden]right- DataContractsArea
OrchestrationArea -[hidden]down- AdaptersArea
AdaptersArea -[hidden]down- EnvironmentArea

@enduml
