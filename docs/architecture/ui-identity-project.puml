BaseModel <|-- CreateUserRequest
BaseModel <|-- CreateUserResponse
BaseModel <|-- CreateUserTokenRequest
BaseModel <|-- UserTokenResponse
BaseModel <|-- UserTokensResponse
BaseModel <|-- RoleAssignmentRequest
BaseModel <|-- RoleAssignmentResponse
BaseModel <|-- RoleAssignmentsResponse
BaseModel <|-- ParentProjectRequest
BaseModel <|-- CreateProjectRequest
BaseModel <|-- ProjectReferenceResponse
BaseModel <|-- ProjectResponse

UserTokensResponse *-- "0..*" UserTokenResponse
RoleAssignmentsResponse *-- "0..*" RoleAssignmentResponse
CreateProjectRequest *-- "1" ParentProjectRequest
ProjectResponse *-- "0..1" ProjectReferenceResponse

@enduml
